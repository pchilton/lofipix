[Unit]
Description=PowerSync Service (lofipix)
Documentation=https://docs.powersync.com/self-hosting/installation/self-hosted-instances
After=network-online.target postgresql.service lofipix-api.service
Wants=network-online.target

[Service]
Type=simple
User=powersync
Group=powersync
WorkingDirectory=/etc/powersync/lofipix
EnvironmentFile=/etc/powersync/lofipix/powersync.env
ExecStart=/usr/bin/node /opt/powersync/service/dist/bin.js start -r unified
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/powersync

[Install]
WantedBy=multi-user.target
