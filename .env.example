# API
NODE_ENV=development
API_URL=https://<region>.lofipix.app
DATABASE_URL=postgres://postgres-user:postgres-password@postgres-host:postgres-port/postgres-db

# Authentication
BETTER_AUTH_SECRET=(openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 64; echo)

# JWT / JWKS (PowerSync client token verification)
POWERSYNC_JWKS_URL=https://<region>.lofipix.app/api/auth/jwks.json
# PowerSync audience the client JWT must target (self-hosted PowerSync).
# Must match client_auth.audience in the PowerSync service config.
POWERSYNC_AUDIENCE=powersync-<region>
# PowerSync storage database URL. Defaults to DATABASE_URL; set this if the
# PowerSync service uses a separate database (e.g. powersync).
# POWERSYNC_STORAGE_URL=postgres://lofipix:lofipix-password@postgres-host:postgres-port/powersync

# SeaweedFS
SEAWEED_URL=https://<region>.lofipix.app
SEAWEED_BUCKET=storage-<region>-lofipix
SEAWEEDFS_ACCESS_KEY=(openssl rand -base64 60 | tr -dc 'a-zA-Z0-9' | head -c 20; echo)
SEAWEEDFS_SECRET_KEY=(openssl rand -base64 60 | tr -dc 'a-zA-Z0-9' | head -c 40; echo)
